import {
    Button,
    VerticalBox,
    HorizontalBox,
    LineEdit,
} from "std-widgets.slint";

// 플러스 버튼 컴포넌트
component BtnPlus inherits Rectangle {
    callback clicked;
    in property <color> theme-color: #000;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? rgba(0, 0, 0, 0.2) : touch.has-hover ? rgba(0, 0, 0, 0.1) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? root.theme-color : transparent;
    Path {
        width: 16px;
        height: 16px;
        stroke: root.theme-color;
        stroke-width: 3px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 0 L 50 100 M 0 50 L 100 50";
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// InputDialog 수정 (Window 상속 제거)
component InputContent inherits Rectangle {
    callback confirmed(string);
    callback cancelled();
    in property <string> dialog_title: "";
    in property <string> placeholder: "";
    width: 350px;
    height: 180px;
    background: #2D2D2D;
    border-radius: 8px;
    border-width: 2px;
    border-color: #444;
    VerticalBox {
        padding: 15px;
        spacing: 12px;
        Text {
            text: root.dialog_title;
            color: #fff;
            font-size: 16px;
            font-weight: 700;
        }

        input_field := LineEdit {
            placeholder-text: root.placeholder;
            // 엔터 키 대응
            accepted => {
                root.confirmed(self.text);
            }
        }

        HorizontalBox {
            spacing: 10px;
            alignment: end;
            Button {
                text: "취소";
                clicked => {
                    root.cancelled();
                }
            }

            Button {
                text: "확인";
                primary: true;
                clicked => {
                    root.confirmed(input_field.text);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    callback close_clicked();
    callback add_doit_item(string);
    callback add_plan_item(string);
    callback add_delegate_item(string);
    callback add_delete_item(string);
    callback dialog_shown();
    in property <float> app_width: 800.0;
    in property <float> app_height: 850.0;
    in-out property <[string]> doit_items: [];
    in-out property <[string]> plan_items: [];
    in-out property <[string]> delegate_items: [];
    in-out property <[string]> delete_items: [];
    in-out property <bool> show_doit_dialog: false;
    in-out property <bool> show_plan_dialog: false;
    in-out property <bool> show_delegate_dialog: false;
    in-out property <bool> show_delete_dialog: false;
    no-frame: true;
    background: transparent;
    width: app_width * 1px;
    height: app_height * 1px;

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 상단 헤더
        Rectangle {
            height: 45px;
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 8px;
                alignment: space-between;
                Text {
                    text: "MY EISENHOWER MATRIX";
                    color: #aaa;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                close_touch := TouchArea {
                    width: 32px;
                    clicked => {
                        root.close_clicked();
                    }
                    Rectangle {
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? #ff5555 : #888;
                            font-size: 24px;
                        }
                    }
                }
            }
        }

        // 메인 매트릭스
        GridLayout {
            spacing: 0;
            
            // --- Q1: DO IT ---
            Rectangle {
                row: 0;
                col: 0;
                width: root.app_width / 2 * 1px;
                background: #F17D7D;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하고 긴급한 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }
                        
                        // 버튼 및 다이얼로그
                        doit_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.show_doit_dialog = true;
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }
                    }

                    for item in root.doit_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                        overflow: elide;
                    }
                }
            }

            // --- Q2: PLAN ---
            Rectangle {
                row: 0;
                col: 1;
                width: root.app_width / 2 * 1px;
                background: #8CC684;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하지만 안긴급";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        plan_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.show_plan_dialog = true;
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }
                    }

                    for item in root.plan_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                        overflow: elide;
                    }
                }
            }

            // --- Q3: DELEGATE ---
            Rectangle {
                row: 1;
                col: 0;
                width: root.app_width / 2 * 1px;
                background: #FFD065;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "긴급하지만 안중요";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delegate_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.show_delegate_dialog = true;
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }
                    }

                    for item in root.delegate_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                        overflow: elide;
                    }
                }
            }

            // --- Q4: DELETE ---
            Rectangle {
                row: 1;
                col: 1;
                width: root.app_width / 2 * 1px;
                background: #D9D9D9;
                border-width: 2px;
                border-color: #000;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "안중요하고 안긴급";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delete_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.show_delete_dialog = true;
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }
                    }

                    for item in root.delete_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                        overflow: elide;
                    }
                }
            }
        }
    }
    
    // 다이얼로그 오버레이
    if root.show_doit_dialog || root.show_plan_dialog || root.show_delegate_dialog || root.show_delete_dialog: Rectangle {
        background: rgba(0, 0, 0, 0.0);
        width: root.width;
        height: root.height;
        TouchArea {
            // 배경 클릭 시 닫히지 않도록 (다이얼로그 내부에서만 닫기 가능)
        }
        
        // DO IT 다이얼로그 (Q1: 왼쪽 위)
        if root.show_doit_dialog: Rectangle {
            // x: 왼쪽 셀의 오른쪽 끝 - 다이얼로그 너비
            // 버튼 위치: -app_width/2 + app_width/2 - 15(padding) - 32(버튼) = -47
            // 다이얼로그를 버튼 왼쪽에 배치
            x: ((-root.app_width / 2) * 1px) + ((root.app_width / 2) * 1px) - 15px - 175px;
            // y: 상단 헤더(45px) + padding(15px) + 버튼 높이(32px) + 여유(10px)
            y: ((-root.app_height / 2) * 1px) + 90px + 15px + 32px + 10px;
            InputContent {
                dialog_title: "중요/긴급 항목 추가";
                confirmed(t) => {
                    root.add_doit_item(t);
                    root.show_doit_dialog = false;
                }
                cancelled => {
                    root.show_doit_dialog = false;
                }
            }
        }
        
        // PLAN 다이얼로그 (Q2: 오른쪽 위)
        if root.show_plan_dialog: Rectangle {
            // x: 오른쪽 셀의 오른쪽 끝 - 다이얼로그 너비
            // 버튼 위치: 0 + app_width/2 - 15 - 32 = app_width/2 - 47
            x: ((root.app_width / 2) * 1px) - 15px - 175px;
            // y: 상단 헤더(45px) + padding(15px) + 버튼 높이(32px) + 여유(10px)
            y: ((-root.app_height / 2) * 1px) + 90px + 15px + 32px + 10px;
            InputContent {
                dialog_title: "중요/안긴급 추가";
                confirmed(t) => {
                    root.add_plan_item(t);
                    root.show_plan_dialog = false;
                }
                cancelled => {
                    root.show_plan_dialog = false;
                }
            }
        }
        
        // DELEGATE 다이얼로그 (Q3: 왼쪽 아래)
        if root.show_delegate_dialog: Rectangle {
            // x: 왼쪽 셀의 오른쪽 끝 - 다이얼로그 너비
            x: ((-root.app_width / 2) * 1px) + ((root.app_width / 2) * 1px) - 15px - 175px;
            // y: 상단 헤더(45px) + 상단 셀 높이 + padding(15px) + 버튼 높이(32px) + 여유(10px)
            y: ((-root.app_height / 2) * 1px) + 90px + (((root.app_height - 100) / 2) * 1px) + 15px + 32px + 10px;
            InputContent {
                dialog_title: "긴급/안중요 추가";
                confirmed(t) => {
                    root.add_delegate_item(t);
                    root.show_delegate_dialog = false;
                }
                cancelled => {
                    root.show_delegate_dialog = false;
                }
            }
        }
        
        // DELETE 다이얼로그 (Q4: 오른쪽 아래)
        if root.show_delete_dialog: Rectangle {
            // x: 오른쪽 셀의 오른쪽 끝 - 다이얼로그 너비
            x: ((root.app_width / 2) * 1px) - 15px - 175px;
            // y: 상단 헤더(45px) + 상단 셀 높이 + padding(15px) + 버튼 높이(32px) + 여유(10px)
            y: ((-root.app_height / 2) * 1px) + 90px + (((root.app_height - 100) / 2) * 1px) + 15px + 32px + 10px;
            InputContent {
                dialog_title: "안중요/안긴급 추가";
                confirmed(t) => {
                    root.add_delete_item(t);
                    root.show_delete_dialog = false;
                }
                cancelled => {
                    root.show_delete_dialog = false;
                }
            }
        }
    }
}
