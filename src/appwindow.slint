import {
    Button,
    VerticalBox,
    HorizontalBox,
    LineEdit,
    CheckBox,
} from "std-widgets.slint";

// 그리드 아이템 컴포넌트 (체크박스 + 텍스트, 더블클릭 수정)
component GridItem inherits HorizontalBox {
    callback item-updated(int, string); // 인덱스, 새 텍스트
    in property <string> item-text: "";
    in property <int> item-index: 0;
    in property <color> text-color: #000;
    spacing: 8px;
    alignment: start;
    
    in-out property <bool> is-editing: root.item-text == "";
    
    checkbox := CheckBox {
        checked: false;
    }
    
    if root.is-editing: edit_field := LineEdit {
        text: root.item-text;
        font-size: 18px;
        min-height: 32px;
        min-width: 200px;
        width: 30%;
        vertical-stretch: 0;
        accepted => {
            if self.text != "" {
                root.item-updated(root.item-index, self.text);
                root.is-editing = false;
            }
        }
    }
    
    if !root.is-editing: text_area := Rectangle {
        height: 32px;
        vertical-stretch: 0;
        background: transparent;
        text_touch := TouchArea {
            double-clicked => {
                root.is-editing = true;
            }
            Text {
                text: root.item-text;
                color: root.text-color;
                font-size: 18px;
                // font-weight: 400;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: 100%;
            }
        }
    }
}

// 플러스 버튼 컴포넌트
component BtnPlus inherits Rectangle {
    callback clicked;
    in property <color> theme-color: #000;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? rgba(0, 0, 0, 0.2) : touch.has-hover ? rgba(0, 0, 0, 0.1) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? root.theme-color : transparent;
    Path {
        width: 16px;
        height: 16px;
        stroke: root.theme-color;
        stroke-width: 3px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 0 L 50 100 M 0 50 L 100 50";
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    callback close_clicked();
    callback add_doit_item(string);
    callback add_plan_item(string);
    callback add_delegate_item(string);
    callback add_delete_item(string);
    callback update_doit_item(int, string);
    callback update_plan_item(int, string);
    callback update_delegate_item(int, string);
    callback update_delete_item(int, string);
    in property <float> app_width: 800.0;
    in property <float> app_height: 850.0;
    in-out property <[string]> doit_items: [];
    in-out property <[string]> plan_items: [];
    in-out property <[string]> delegate_items: [];
    in-out property <[string]> delete_items: [];
    no-frame: true;
    background: transparent;
    width: app_width * 1px;
    height: app_height * 1px;

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 상단 헤더
        Rectangle {
            height: 45px;
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 8px;
                alignment: space-between;
                Text {
                    text: "MY EISENHOWER MATRIX";
                    color: #aaa;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                close_touch := TouchArea {
                    width: 32px;
                    clicked => {
                        root.close_clicked();
                    }
                    Rectangle {
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? #ff5555 : #888;
                            font-size: 24px;
                        }
                    }
                }
            }
        }

        // 메인 매트릭스
        GridLayout {
            spacing: 0;
            
            // --- Q1: DO IT ---
            Rectangle {
                row: 0;
                col: 0;
                width: root.app_width / 2 * 1px;
                background: #F17D7D;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하고 긴급한 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }
                        
                        // 버튼
                        doit_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_doit_item("");
                            }
                        }
                    }

                    for item[index] in root.doit_items: GridItem {
                        item-text: item;
                        item-index: index;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_doit_item(idx, new-text);
                        }
                    }
                }
            }

            // --- Q2: PLAN ---
            Rectangle {
                row: 0;
                col: 1;
                width: root.app_width / 2 * 1px;
                background: #8CC684;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하지만 안긴급";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        plan_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_plan_item("");
                            }
                        }
                    }

                    for item[index] in root.plan_items: GridItem {
                        item-text: item;
                        item-index: index;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_plan_item(idx, new-text);
                        }
                    }
                }
            }

            // --- Q3: DELEGATE ---
            Rectangle {
                row: 1;
                col: 0;
                width: root.app_width / 2 * 1px;
                background: #FFD065;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "긴급하지만 안중요";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delegate_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_delegate_item("");
                            }
                        }
                    }

                    for item[index] in root.delegate_items: GridItem {
                        item-text: item;
                        item-index: index;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_delegate_item(idx, new-text);
                        }
                    }
                }
            }

            // --- Q4: DELETE ---
            Rectangle {
                row: 1;
                col: 1;
                width: root.app_width / 2 * 1px;
                background: #D9D9D9;
                border-width: 2px;
                border-color: #000;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "안중요하고 안긴급";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delete_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_delete_item("");
                            }
                        }
                    }

                    for item[index] in root.delete_items: GridItem {
                        item-text: item;
                        item-index: index;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_delete_item(idx, new-text);
                        }
                    }
                }
            }
        }
    }
}
