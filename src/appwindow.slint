import {
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { GridItem } from "./components/grid_item.slint";
import { BtnPlus } from "./components/btn_plus.slint";

export component AppWindow inherits Window {
    callback close_clicked();
    callback add_doit_item(string);
    callback add_plan_item(string);
    callback add_delegate_item(string);
    callback add_delete_item(string);
    callback update_doit_item(int, string);
    callback update_plan_item(int, string);
    callback update_delegate_item(int, string);
    callback update_delete_item(int, string);
    callback toggle_doit_checked(int);
    callback toggle_plan_checked(int);
    callback toggle_delegate_checked(int);
    callback toggle_delete_checked(int);
    in property <float> app_width: 800.0;
    in property <float> app_height: 850.0;
    in-out property <[string]> doit_items: [];
    in-out property <[string]> plan_items: [];
    in-out property <[string]> delegate_items: [];
    in-out property <[string]> delete_items: [];
    in-out property <[bool]> doit_checked: [];
    in-out property <[bool]> plan_checked: [];
    in-out property <[bool]> delegate_checked: [];
    in-out property <[bool]> delete_checked: [];
    no-frame: true;
    background: transparent;
    width: app_width * 1px;
    height: app_height * 1px;

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 상단 헤더
        Rectangle {
            height: 45px;
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 8px;
                alignment: space-between;
                Text {
                    text: "Eisenhower Matrix";
                    color: #aaa;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                close_touch := TouchArea {
                    width: 32px;
                    clicked => {
                        root.close_clicked();
                    }
                    Rectangle {
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? #ff5555 : #888;
                            font-size: 24px;
                        }
                    }
                }
            }
        }

        // 메인 매트릭스
        GridLayout {
            spacing: 0;
            
            // --- Q1: DO IT ---
            Rectangle {
                row: 0;
                col: 0;
                width: root.app_width / 2 * 1px;
                background: #FFB3B3;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하고 긴급한 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }
                        
                        // 버튼
                        doit_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_doit_item("");
                            }
                        }
                    }

                    for item[index] in root.doit_items: GridItem {
                        item-text: item;
                        item-index: index;
                        item-checked: index < root.doit_checked.length ? root.doit_checked[index] : false;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_doit_item(idx, new-text);
                        }
                        checked-toggled(idx) => {
                            root.toggle_doit_checked(idx);
                        }
                    }
                }
            }

            // --- Q2: PLAN ---
            Rectangle {
                row: 0;
                col: 1;
                width: root.app_width / 2 * 1px;
                background: #B5E4CA;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하지만 긴급하지 않은 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        plan_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_plan_item("");
                            }
                        }
                    }

                    for item[index] in root.plan_items: GridItem {
                        item-text: item;
                        item-index: index;
                        item-checked: index < root.plan_checked.length ? root.plan_checked[index] : false;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_plan_item(idx, new-text);
                        }
                        checked-toggled(idx) => {
                            root.toggle_plan_checked(idx);
                        }
                    }
                }
            }

            // --- Q3: DELEGATE ---
            Rectangle {
                row: 1;
                col: 0;
                width: root.app_width / 2 * 1px;
                background: #FFEBB3;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "긴급하지만 중요하지 않은 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delegate_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_delegate_item("");
                            }
                        }
                    }

                    for item[index] in root.delegate_items: GridItem {
                        item-text: item;
                        item-index: index;
                        item-checked: index < root.delegate_checked.length ? root.delegate_checked[index] : false;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_delegate_item(idx, new-text);
                        }
                        checked-toggled(idx) => {
                            root.toggle_delegate_checked(idx);
                        }
                    }
                }
            }

            // --- Q4: DELETE ---
            Rectangle {
                row: 1;
                col: 1;
                width: root.app_width / 2 * 1px;
                background: #F0F0F0;
                border-width: 2px;
                border-color: #000;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "긴급하지 않고 중요하지 않은 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delete_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                root.add_delete_item("");
                            }
                        }
                    }

                    for item[index] in root.delete_items: GridItem {
                        item-text: item;
                        item-index: index;
                        item-checked: index < root.delete_checked.length ? root.delete_checked[index] : false;
                        text-color: #000;
                        item-updated(idx, new-text) => {
                            root.update_delete_item(idx, new-text);
                        }
                        checked-toggled(idx) => {
                            root.toggle_delete_checked(idx);
                        }
                    }
                }
            }
        }
    }
}
