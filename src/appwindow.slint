import {
    Button,
    VerticalBox,
    HorizontalBox,
    LineEdit,
} from "std-widgets.slint";

// 플러스 버튼 컴포넌트
component BtnPlus inherits Rectangle {
    callback clicked;
    in property <color> theme-color: #000;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? rgba(0, 0, 0, 0.2) : touch.has-hover ? rgba(0, 0, 0, 0.1) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? root.theme-color : transparent;
    Path {
        width: 16px;
        height: 16px;
        stroke: root.theme-color;
        stroke-width: 3px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 0 L 50 100 M 0 50 L 100 50";
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// InputDialog 수정 (Window 상속 제거)
component InputContent inherits Rectangle {
    callback confirmed(string);
    callback cancelled();
    in property <string> dialog_title: "";
    in property <string> placeholder: "";
    width: 350px;
    height: 180px;
    background: #2D2D2D;
    border-radius: 8px;
    border-width: 2px;
    border-color: #444;
    VerticalBox {
        padding: 15px;
        spacing: 12px;
        Text {
            text: root.dialog_title;
            color: #fff;
            font-size: 16px;
            font-weight: 700;
        }

        input_field := LineEdit {
            placeholder-text: root.placeholder;
            // 엔터 키 대응
            accepted => {
                root.confirmed(self.text);
            }
        }

        HorizontalBox {
            spacing: 10px;
            alignment: end;
            Button {
                text: "취소";
                clicked => {
                    root.cancelled();
                }
            }

            Button {
                text: "확인";
                primary: true;
                clicked => {
                    root.confirmed(input_field.text);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    callback close_clicked();
    callback add_doit_item(string);
    callback add_plan_item(string);
    callback add_delegate_item(string);
    callback add_delete_item(string);
    callback dialog_shown();
    in property <float> app_width: 800.0;
    in property <float> app_height: 850.0;
    in-out property <[string]> doit_items: [];
    in-out property <[string]> plan_items: [];
    in-out property <[string]> delegate_items: [];
    in-out property <[string]> delete_items: [];
    no-frame: true;
    background: transparent;
    width: app_width * 1px;
    height: app_height * 1px;

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 상단 헤더
        Rectangle {
            height: 45px;
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 8px;
                alignment: space-between;
                Text {
                    text: "MY EISENHOWER MATRIX";
                    color: #aaa;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                close_touch := TouchArea {
                    width: 32px;
                    clicked => {
                        root.close_clicked();
                    }
                    Rectangle {
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? #ff5555 : #888;
                            font-size: 24px;
                        }
                    }
                }
            }
        }

        // 메인 매트릭스
        GridLayout {
            spacing: 0;
            
            // --- Q1: DO IT ---
            Rectangle {
                row: 0;
                col: 0;
                background: #F17D7D;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하고 긴급한 일";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }
                        
                        // 버튼 및 팝업
                        doit_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                doit_popup.show();
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }

                        doit_popup := PopupWindow {
                            x: ((root.app_width / 2) * 1px) - 320px; // 버튼 왼쪽으로 팝업 배치 (창 크기에 맞춰 조절)
                            y: doit_btn.height + 10px;
                            InputContent {
                                dialog_title: "중요/긴급 항목 추가";
                                confirmed(t) => {
                                    root.add_doit_item(t);
                                    doit_popup.close();
                                }
                                cancelled => {
                                    doit_popup.close();
                                }
                            }
                        }
                    }

                    for item in root.doit_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                    }
                }
            }

            // --- Q2: PLAN ---
            Rectangle {
                row: 0;
                col: 1;
                background: #8CC684;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "중요하지만 안긴급";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        plan_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                plan_popup.show();
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }

                        plan_popup := PopupWindow {
                            x: ((root.app_width / 2) * 1px) - 320px;
                            y: plan_btn.height + 10px;
                            InputContent {
                                dialog_title: "계획 항목 추가";
                                confirmed(t) => {
                                    root.add_plan_item(t);
                                    plan_popup.close();
                                }
                                cancelled => {
                                    plan_popup.close();
                                }
                            }
                        }
                    }

                    for item in root.plan_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                    }
                }
            }

            // --- Q3: DELEGATE ---
            Rectangle {
                row: 1;
                col: 0;
                background: #FFD065;
                border-width: 2px;
                border-color: #000;
                min-height: (root.app_height - 100) / 2 * 1px;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "긴급하지만 안중요";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delegate_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                delegate_popup.show();
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }

                        delegate_popup := PopupWindow {
                            x: ((root.app_width / 2) * 1px) - 320px;
                            y: delegate_btn.height + 10px;
                            InputContent {
                                dialog_title: "위임 항목 추가";
                                confirmed(t) => {
                                    root.add_delegate_item(t);
                                    delegate_popup.close();
                                }
                                cancelled => {
                                    delegate_popup.close();
                                }
                            }
                        }
                    }

                    for item in root.delegate_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                    }
                }
            }

            // --- Q4: DELETE ---
            Rectangle {
                row: 1;
                col: 1;
                background: #D9D9D9;
                border-width: 2px;
                border-color: #000;
                VerticalBox {
                    padding: 15px;
                    alignment: start;
                    HorizontalBox {
                        alignment: space-between;
                        Text {
                            text: "안중요하고 안긴급";
                            font-size: 20px;
                            font-weight: 900;
                            color: #000;
                        }

                        delete_btn := BtnPlus {
                            theme-color: #000;
                            clicked => {
                                delete_popup.show();
                                root.dialog_shown(); // Rust로 신호를 보냄
                            }
                        }

                        delete_popup := PopupWindow {
                            x: ((root.app_width / 2) * 1px) - 320px;
                            y: delete_btn.height + 10px;
                            InputContent {
                                dialog_title: "삭제 항목 추가";
                                confirmed(t) => {
                                    root.add_delete_item(t);
                                    delete_popup.close();
                                }
                                cancelled => {
                                    delete_popup.close();
                                }
                            }
                        }
                    }

                    for item in root.delete_items: Text {
                        text: "• " + item;
                        color: #000;
                        font-size: 16px;
                    }
                }
            }
        }
    }
}
