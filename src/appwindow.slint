import {
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { MatrixGrid } from "./components/matrix_grid.slint";

export component AppWindow inherits Window {
    callback close_clicked();
    callback add_doit_item(string);
    callback add_plan_item(string);
    callback add_delegate_item(string);
    callback add_delete_item(string);
    callback update_doit_item(int, string);
    callback update_plan_item(int, string);
    callback update_delegate_item(int, string);
    callback update_delete_item(int, string);
    callback toggle_doit_checked(int);
    callback toggle_plan_checked(int);
    callback toggle_delegate_checked(int);
    callback toggle_delete_checked(int);
    callback remove_doit_item(int);
    callback remove_plan_item(int);
    callback remove_delegate_item(int);
    callback remove_delete_item(int);
    in property <float> app_width: 800.0;
    in property <float> app_height: 850.0;
    in-out property <[string]> doit_items: [];
    in-out property <[string]> plan_items: [];
    in-out property <[string]> delegate_items: [];
    in-out property <[string]> delete_items: [];
    in-out property <[bool]> doit_checked: [];
    in-out property <[bool]> plan_checked: [];
    in-out property <[bool]> delegate_checked: [];
    in-out property <[bool]> delete_checked: [];
    in-out property <[string]> doit_created_dt: [];
    in-out property <[string]> plan_created_dt: [];
    in-out property <[string]> delegate_created_dt: [];
    in-out property <[string]> delete_created_dt: [];
    no-frame: true;
    background: transparent;
    width: app_width * 1px;
    height: app_height * 1px;

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 상단 헤더
        Rectangle {
            height: 45px;
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 8px;
                alignment: space-between;
                Text {
                    text: "Eisenhower Matrix";
                    color: #aaa;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                close_touch := TouchArea {
                    width: 32px;
                    clicked => {
                        root.close_clicked();
                    }
                    Rectangle {
                        Text {
                            text: "×";
                            color: close_touch.has-hover ? #ff5555 : #888;
                            font-size: 24px;
                        }
                    }
                }
            }
        }

        // 메인 매트릭스
        GridLayout {
            spacing: 0;
            
            // --- Q1: DO IT ---
            doit_grid := MatrixGrid {
                row: 0;
                col: 0;
                title: "중요하고 긴급한 일";
                background-color: #FFB3B3;
                text-color: #000;
                items: root.doit_items;
                checked-states: root.doit_checked;
                created-dt: root.doit_created_dt;
                grid-width: root.app_width / 2 * 1px;
                grid-height: (root.app_height - 100) / 2 * 1px;
                add-item => {
                    root.add_doit_item("");
                }
                update-item(idx, new-text) => {
                    root.update_doit_item(idx, new-text);
                }
                toggle-checked(idx) => {
                    root.toggle_doit_checked(idx);
                }
                remove-item(idx) => {
                    root.remove_doit_item(idx);
                }
            }

            // --- Q2: PLAN ---
            plan_grid := MatrixGrid {
                row: 0;
                col: 1;
                title: "중요하지만 긴급하지 않은 일";
                background-color: #B5E4CA;
                text-color: #000;
                items: root.plan_items;
                checked-states: root.plan_checked;
                created-dt: root.plan_created_dt;
                grid-width: root.app_width / 2 * 1px;
                grid-height: (root.app_height - 100) / 2 * 1px;
                add-item => {
                    root.add_plan_item("");
                }
                update-item(idx, new-text) => {
                    root.update_plan_item(idx, new-text);
                }
                toggle-checked(idx) => {
                    root.toggle_plan_checked(idx);
                }
                remove-item(idx) => {
                    root.remove_plan_item(idx);
                }
            }

            // --- Q3: DELEGATE ---
            delegate_grid := MatrixGrid {
                row: 1;
                col: 0;
                title: "긴급하지만 중요하지 않은 일";
                background-color: #FFEBB3;
                text-color: #000;
                items: root.delegate_items;
                checked-states: root.delegate_checked;
                created-dt: root.delegate_created_dt;
                grid-width: root.app_width / 2 * 1px;
                grid-height: (root.app_height - 100) / 2 * 1px;
                add-item => {
                    root.add_delegate_item("");
                }
                update-item(idx, new-text) => {
                    root.update_delegate_item(idx, new-text);
                }
                toggle-checked(idx) => {
                    root.toggle_delegate_checked(idx);
                }
                remove-item(idx) => {
                    root.remove_delegate_item(idx);
                }
            }

            // --- Q4: DELETE ---
            delete_grid := MatrixGrid {
                row: 1;
                col: 1;
                title: "긴급하지 않고 중요하지 않은 일";
                background-color: #F0F0F0;
                text-color: #000;
                items: root.delete_items;
                checked-states: root.delete_checked;
                created-dt: root.delete_created_dt;
                grid-width: root.app_width / 2 * 1px;
                grid-height: (root.app_height - 100) / 2 * 1px;
                add-item => {
                    root.add_delete_item("");
                }
                update-item(idx, new-text) => {
                    root.update_delete_item(idx, new-text);
                }
                toggle-checked(idx) => {
                    root.toggle_delete_checked(idx);
                }
                remove-item(idx) => {
                    root.remove_delete_item(idx);
                }
            }
        }
    }
}
